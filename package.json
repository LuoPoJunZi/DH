{
  "name": "luopo-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fast, privacy-first collection of browser-based online tools.",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "generate:seo": "node scripts/generate-seo.mjs",
    "sync:navigation": "node scripts/sync-web-navigation.mjs",
    "predev": "npm run generate:seo",
    "dev": "vite",
    "prebuild": "npm run generate:seo",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "^6.4.1"
  }
}
